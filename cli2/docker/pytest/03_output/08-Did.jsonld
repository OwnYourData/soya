    "did": "https://www.w3.org/ns/did#"
  },
  "@graph": [
    {
      "@id": "Did",
      "@type": "owl:Class",
      "subClassOf": "did:DIDSubject"
    },
    {
      "@id": "id",
      "@type": "owl:DatatypeProperty",
      "domain": "Did",
      "range": "xsd:string"
    },
    {
      "@id": "alsoKnownAs",
      "@type": "owl:DatatypeProperty",
      "domain": "Did",
      "range": "xsd:string"
    },
    {
      "@id": "verificationMethod",
      "@type": "owl:ObjectProperty",
