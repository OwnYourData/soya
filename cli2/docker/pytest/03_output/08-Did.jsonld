          "sh:path": "controller",
          "sh:pattern": "^did:[a-z0-9]+:(([A-Za-z0-9._-]|%[0-9A-Fa-f]{2})*:)*([A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+$",
          "sh:message": "invalid 'controller'"
        },
        {
          "sh:path": "alsoKnownAs",
          "sh:pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "sh:message": "invalid 'alsoKnownAs'"
