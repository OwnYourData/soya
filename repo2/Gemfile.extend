# similarity scores for POST /api/soya/similar
# (was present in the legacy repository/Gemfile but got lost in repo2;
#  without it String::Similarity raises and "rescue 0" silently
#  turns every similarity score into 0)
gem 'string-similarity'

# turtle output
gem 'rdf'
gem 'rdf-normalize'
gem 'rdf-turtle'
gem 'json-ld'

# UI
gem 'sass-rails', '~> 5.0'
gem 'uglifier', '>= 1.3.0'
gem 'jquery-rails'
gem 'jquery-ui-rails'
gem "bootstrap-sass", ">= 3.4.1"
gem 'font-awesome-rails'
