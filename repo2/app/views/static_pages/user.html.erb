<div class="mx-auto max-w-xl px-4 py-8">
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">Profile</h1>

  <% if flash[:notice] %>
    <div class="mt-4 rounded-md bg-green-50 p-4 text-sm text-green-700"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:error] %>
    <div class="mt-4 rounded-md bg-red-50 p-4 text-sm text-red-700"><%= flash[:error] %></div>
  <% end %>

  <dl class="mt-6 space-y-2">
    <div class="flex gap-2">
      <dt class="font-semibold text-gray-700">user:</dt>
      <dd class="text-gray-900"><%= @user.name.to_s rescue "" %></dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-semibold text-gray-700">org:</dt>
      <dd class="text-gray-900"><%= @org.name.to_s rescue "" %></dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-semibold text-gray-700">scopes:</dt>
      <dd class="text-gray-900"><code><%= @oauth.scopes.to_s rescue "" %></code></dd>
    </div>
  </dl>

  <form action="/soya/user" method="post" class="mt-6 space-y-4">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div>
      <label for="full_name" class="block text-sm font-medium text-gray-700">Full name</label>
      <input type="text" name="full_name" id="full_name"
             value="<%= @user.full_name %>"
             class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
    </div>

    <div class="flex items-center gap-4 pt-2">
      <button type="submit"
              class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
        Save
      </button>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-900">back</a>
    </div>
  </form>
</div>
