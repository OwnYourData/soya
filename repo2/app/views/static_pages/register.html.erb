<div class="mx-auto max-w-xl px-4 py-8">
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">User Registration</h1>

  <% if flash[:error] %>
    <div class="mt-4 rounded-md bg-red-50 p-4 text-sm text-red-700"><%= flash[:error] %></div>
  <% end %>

  <p class="mt-4 text-gray-600">
    Create a user for this SOyA repository. You will receive an
    <strong>APP_KEY</strong> and <strong>APP_SECRET</strong> to authenticate
    (e.g. <code>soya push --repo ...</code> or logging in with SOyA-Bud).
  </p>

  <form action="/soya/register" method="post" class="mt-6 space-y-4">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div>
      <label for="organization" class="block text-sm font-medium text-gray-700">Organization</label>
      <input type="text" name="organization" id="organization" required
             value="<%= params[:organization] %>"
             class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      <p class="mt-1 text-xs text-gray-500">Existing organization names are reused, new ones are created.</p>
    </div>

    <div>
      <label for="username" class="block text-sm font-medium text-gray-700">User name</label>
      <input type="text" name="username" id="username" required
             pattern="[a-zA-Z0-9._\-]+"
             value="<%= params[:username] %>"
             class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      <p class="mt-1 text-xs text-gray-500">Letters, digits, '.', '_' and '-' only; unique within the organization.</p>
    </div>

    <div>
      <label for="full_name" class="block text-sm font-medium text-gray-700">Full name (optional)</label>
      <input type="text" name="full_name" id="full_name"
             value="<%= params[:full_name] %>"
             class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
    </div>

    <div class="flex items-center gap-4 pt-2">
      <button type="submit"
              class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
        Register
      </button>
      <a href="/" class="text-sm text-gray-600 hover:text-gray-900">back</a>
    </div>
  </form>
</div>
