<div class="mx-auto max-w-xl px-4 py-8">
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">Registration successful</h1>

  <p class="mt-4 text-gray-600">
    User <strong><%= @user.name %></strong> was created in organization
    <strong><%= @org.name %></strong>.
  </p>

  <div class="mt-6 rounded-md bg-yellow-50 p-4 text-sm text-yellow-800">
    <strong>Store these credentials now — the secret is shown only once!</strong>
  </div>

  <dl class="mt-4 space-y-3">
    <div>
      <dt class="text-sm font-medium text-gray-700">APP_KEY</dt>
      <dd><code class="block mt-1 rounded bg-gray-100 p-2 text-sm break-all"><%= @oauth.uid %></code></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-700">APP_SECRET</dt>
      <dd><code class="block mt-1 rounded bg-gray-100 p-2 text-sm break-all"><%= @oauth.secret %></code></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-700">Scopes</dt>
      <dd><code class="block mt-1 rounded bg-gray-100 p-2 text-sm"><%= @oauth.scopes %></code></dd>
    </div>
  </dl>

  <p class="mt-6 text-sm text-gray-600">
    Obtain a bearer token via
    <code>POST /oauth/token</code> with <code>grant_type=client_credentials</code>.
  </p>

  <a href="/" class="mt-6 inline-block text-sm text-gray-600 hover:text-gray-900">back</a>
</div>
